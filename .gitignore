# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
*.egg

# Virtual environments
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Test / coverage
.pytest_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/

# Simulation output data (large binary/json files)
examples/output/
*.npz
*.mat

# Reference data (large binary/json files)
/data/

# Visualization export data (generated, not source)
comparison_tools/*.json
comparison_tools/*.png
comparison_tools/*.mat

# Root-level generated images
*.png

# Web showcase: the page is source, its assets are build output.
# Both `*.png` and `*.npz` above are bare patterns, so they match at ANY depth --
# without these negations a rebuilt asset would be silently untracked.
web/site/assets/
!web/site/*.html
!web/site/*.css
!web/site/*.js

# OS
.DS_Store
Thumbs.db
nul

# aws deploy settings (account-specific)
web/.aws-deploy.env
